if SHIELD_CORNE_DONGLE

# Max 16 characters in keyboard name
config ZMK_KEYBOARD_NAME
    default "Ste Corne BT"

# This nice_nano is the split central (the dongle); both halves are peripherals.
config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Left + right halves = 2 peripherals.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# 2 peripherals + 5 host BT profiles (keymap uses BT_SEL 0-4).
config BT_MAX_CONN
    default 7

# Keep in sync with BT_MAX_CONN.
config BT_MAX_PAIRED
    default 7

endif
