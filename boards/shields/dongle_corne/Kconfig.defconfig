# The shield is `dongle_corne`, not `corne_dongle`, on purpose: ZMK builds the
# list of candidate .conf/.keymap names by stripping trailing `_`-separated
# pieces off the shield name, so `corne_dongle` would also match `corne.*` in
# the config dir — and `config/corne.keymap` (checked before the shield's own
# name) overrides `&nice_view_spi`, a label that only exists when the nice_view
# shield is in the build. `dongle_corne` only ever matches `dongle*`.
if SHIELD_DONGLE_CORNE

# Max 16 characters in keyboard name
config ZMK_KEYBOARD_NAME
    default "Ste Corne BT"

# This nice_nano is the split central (the dongle); both halves are peripherals.
config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Left + right halves = 2 peripherals.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# 2 peripherals + 5 host BT profiles (keymap uses BT_SEL 0-4).
config BT_MAX_CONN
    default 7

# Keep in sync with BT_MAX_CONN.
config BT_MAX_PAIRED
    default 7

endif
